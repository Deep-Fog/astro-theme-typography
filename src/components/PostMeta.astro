---
import type { Post } from '~/types'
import { formatDate } from '~/utils'
import PostCategory from './PostCategory.astro'

interface Props {
  post: Post
  level?: 1 | 2 | 3
}

const { post, level = 1 } = Astro.props
const { translate: t } = Astro.locals

const categoryList = post.data.categories ?? []
const HeadingTag = `h${level}` as 'h1' | 'h2' | 'h3'
// level 1 = 文章页主标题（30px）；level 2/3 = 列表页条目标题（20px）
const titleClass = level === 1 ? 'article-title' : 'post-title'
const dateValue = post.data.modDate ?? post.data.pubDate
---

<header flex="~ col gap-2">
  <HeadingTag class={titleClass}>
    <a class="not-prose" href={`/posts/${post.id}/`}>{post.data.title}</a>
  </HeadingTag>
  <div class="text-3.5">
    <span>{t(post.data.modDate ? 'updated_at' : 'posted_at')}</span>
    <time datetime={dateValue.toISOString()}>{formatDate(dateValue)}</time>
    {categoryList.map((category) => <PostCategory category={category} />)}
  </div>
</header>
