---
// PWA注册脚本
const baseUrl = import.meta.env.BASE_URL
const swPath = baseUrl.endsWith('/') ? `${baseUrl}sw.js` : `${baseUrl}/sw.js`
---

<script is:inline define:vars={{ swPath }}>
  // Only register once per tab; swup re-executes inline head scripts on every navigation.
  if ('serviceWorker' in navigator && !window.__swRegistered) {
    window.__swRegistered = true
    window.addEventListener('load', () => {
      navigator.serviceWorker.register(swPath).catch((error) => {
        console.warn('ServiceWorker registration failed:', error)
      })
    })
  }
</script>
