---
import { themeConfig } from '~/.config'

const { title, subtitle } = themeConfig.site
const titleCharacters = Array.from(title)
---

<hgroup lg="write-vertical-right items-start b-l-2px b-l-primary text-left" flex="~ col gap-2.5" class="text-center">
  <a class="not-underline-hover site-title-link" lg:p="x-2.5 b-12" hover:lg=" bg-primary color-background" href="/">
    <span class="site-title-link-content">
      <h3 class="text-5 font-extrabold font-header">{subtitle}</h3>
      <h1 class="text-8 font-extrabold font-header site-title-han-webfont site-title-han-stack" aria-label={title}>
        {
          titleCharacters.map((char) => (
            <span aria-hidden="true" class="site-title-han-char">
              {char}
            </span>
          ))
        }
      </h1>
    </span>
  </a>
</hgroup>

<style is:global>
  .site-title-han-webfont {
    font-family: 'Source Han Serif SC VF', 'Source Han Serif SC', 'Source Han Serif CN', serif;
    font-weight: 900;
    font-style: normal;
  }

  .site-title-han-stack {
    margin: 0;
  }

  .site-title-han-char {
    display: inline;
  }

  .site-title-link {
    display: inline-block;
  }

  .site-title-link-content {
    display: inline-block;
  }

  @media (min-width: 1024px) {
    .site-title-link {
      transition:
        transform 640ms cubic-bezier(0.22, 1, 0.36, 1),
        background-color 720ms cubic-bezier(0.22, 1, 0.36, 1),
        color 720ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .site-title-link:hover {
      transform: translate3d(-0.36rem, 0, 0);
    }

    .site-title-link-content {
      transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .site-title-link:hover .site-title-link-content {
      transform: translate3d(0, 0.9375rem, 0);
    }

    .site-title-han-stack {
      writing-mode: initial;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.08em;
      line-height: 1;
    }

    .site-title-han-char {
      display: block;
      line-height: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title-link,
    .site-title-link-content {
      transition: none;
    }
  }
</style>
